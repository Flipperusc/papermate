PAPERMATE_APP_NAME=PaperMate
PAPERMATE_UPLOAD_DIR=data/uploads
PAPERMATE_CHROMA_DIR=data/chroma_db
PAPERMATE_DB_PATH=data/papermate.db
PAPERMATE_LOG_LEVEL=INFO
PAPERMATE_PDF_PARSE_PROVIDER=mineru
# Strongly recommended on cloud servers. Leave empty only for local development.
PAPERMATE_APP_PASSWORD=
# Host port used by docker-compose.yml.
PAPERMATE_HOST_PORT=8501

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# MinerU PDF-to-Markdown API
# Fill your token here after copying this file to .env.
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_IS_OCR=true
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=en
MINERU_POLL_INTERVAL=3
MINERU_POLL_TIMEOUT=600
MINERU_OUTPUT_DIR=data/mineru_outputs
