# PaperMate application
PAPERMATE_APP_NAME=PaperMate
APP_ENV=local
PAPERMATE_LOG_LEVEL=INFO

# Strongly recommended on cloud servers. Leave empty only for local development.
PAPERMATE_APP_PASSWORD=

# Host port used by docker-compose.yml.
PAPERMATE_HOST_PORT=8501

# Local paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
MARKDOWN_DIR=data/markdown
CHROMA_DIR=data/chroma_db
BM25_DIR=data/bm25
LOG_DIR=logs
DB_PATH=data/papermate.db

# DeepSeek LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Markdown translation
TRANSLATION_ENABLED=true
TRANSLATION_PROVIDER=deepseek
TRANSLATION_MODEL=deepseek-chat
TRANSLATION_CHUNK_SIZE=3500
TRANSLATION_TIMEOUT=60

# PDF-to-Markdown parser
PDF_PARSE_PROVIDER=mineru
MINERU_API_TOKEN=
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_IS_OCR=true
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=en
MINERU_POLL_INTERVAL=3
MINERU_POLL_TIMEOUT=600

# Embedding API, Zhipu BigModel embedding-3
EMBEDDING_PROVIDER=zhipu
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=2048

# RAG chunking
RAG_CHUNK_STRATEGY=semantic_multimodal
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=100
TABLE_LARGE_ROW_CHUNK_SIZE=20
TABLE_WIDE_COLUMN_GROUP_SIZE=9

# Qwen VLM for image-bound multimodal chunks. VLM_API_KEY takes precedence if set.
DASHSCOPE_API_KEY=
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen3.6-plus
VLM_TIMEOUT=90
VLM_TEMPERATURE=0.1
VLM_MAX_TOKENS=512

# Optional aliases for Zhipu credentials. EMBEDDING_API_KEY takes precedence.
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Hybrid Retrieval / RRF
VECTOR_TOP_K=40
BM25_TOP_K=40
FINAL_TOP_K=8
RRF_K=60
CONTEXT_MAX_CHARS=9000
CONTEXT_EXPAND_WINDOW=1
RERANK_ENABLED=true
RERANK_TOP_K=30
RERANK_BATCH_SIZE=8

# Shared external API retry policy for LLM, embedding, and compatible clients.
EXTERNAL_API_MAX_ATTEMPTS=2
EXTERNAL_API_RETRY_BASE_SECONDS=1
EXTERNAL_API_RETRY_MAX_SECONDS=8

# Optional fallback values for OpenAI-compatible services.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
