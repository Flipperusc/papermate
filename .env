# PaperMate application
PAPERMATE_APP_NAME=PaperMate
APP_ENV=local
PAPERMATE_LOG_LEVEL=INFO

# Strongly recommended on cloud servers. Leave empty only for local development.
PAPERMATE_APP_PASSWORD=ture

# Host port used by docker-compose.yml.
PAPERMATE_HOST_PORT=8501

# Local paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
MARKDOWN_DIR=data/markdown
CHROMA_DIR=data/chroma_db
BM25_DIR=data/bm25
LOG_DIR=logs
DB_PATH=data/papermate.db

# DeepSeek LLM
DEEPSEEK_API_KEY=sk-d6e147ff08aa4e1ea071ff9150c66252
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# PDF-to-Markdown parser
PDF_PARSE_PROVIDER=mineru
MINERU_API_TOKEN=eyJ0eXBlIjoiSldUIiwiYWxnIjoiSFM1MTIifQ.eyJqdGkiOiIxMDEwMDI5NSIsInJvbCI6IlJPTEVfUkVHSVNURVIiLCJpc3MiOiJPcGVuWExhYiIsImlhdCI6MTc3NzcyOTY0OSwiY2xpZW50SWQiOiJsa3pkeDU3bnZ5MjJqa3BxOXgydyIsInBob25lIjoiIiwib3BlbklkIjpudWxsLCJ1dWlkIjoiYWFkMmVlNzQtN2U3YS00OTc5LWE0MDctNTVjYWExZDY0NWI1IiwiZW1haWwiOiIiLCJleHAiOjE3ODU1MDU2NDl9.uRUx6UXPxTbVmk9u4uyXwmuP9FyFy5ePoNqEF4bT9fqXC5iFTmcG26dOzJYj7xuFJY4B6x8jFxvHqlYLsH4DnA
MINERU_BASE_URL=https://mineru.net
MINERU_MODEL_VERSION=vlm
MINERU_IS_OCR=true
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_LANGUAGE=en
MINERU_POLL_INTERVAL=3
MINERU_POLL_TIMEOUT=600

# Embedding API, Zhipu BigModel embedding-3
EMBEDDING_PROVIDER=zhipu
EMBEDDING_API_KEY=c015b4de0c874ed08b858cc7f4a3420f.cnLjDogCQfd7449T
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=2048

# Optional aliases for Zhipu credentials. EMBEDDING_API_KEY takes precedence.
ZHIPU_API_KEY=c015b4de0c874ed08b858cc7f4a3420f.cnLjDogCQfd7449T
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Hybrid Retrieval / RRF
VECTOR_TOP_K=20
BM25_TOP_K=20
FINAL_TOP_K=6
RRF_K=60
CONTEXT_MAX_CHARS=6000
CONTEXT_EXPAND_WINDOW=0

# Optional fallback values for OpenAI-compatible services.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
